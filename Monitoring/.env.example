# Monitoring Service Environment Configuration
# Copy this file to .env (do NOT commit .env with real credentials)

# ── Service Network & Ports ──────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://workflow-backend:5000

# ── MongoDB Read-Only User Setup ──────────────────────────────────────────────
# For security and multi-tenant least privilege, Monitoring MUST connect using
# a separate read-only MongoDB user. To create this user in mongosh / Atlas:
#
#   use workflow-engine
#   db.createUser({
#     user: "monitoring_readonly",
#     pwd: "REPLACE_WITH_STRONG_PASSWORD",
#     roles: [
#       { role: "read", db: "workflow-engine" }
#     ]
#   })
#
# In production (NODE_ENV=production), MONITORING_MONGODB_URI is strictly required.
# Fallback to MONGODB_URI is completely disabled in production.
MONITORING_MONGODB_URI=mongodb+srv://<monitoring_readonly_user>:<password>@<cluster>.mongodb.net/workflow-engine
# Development fallback only (shared backend URI):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workflow-engine

# ── Telemetry & Health Checks ────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
DEPENDENCY_TIMEOUT_MS=4000

# ── Alerting Engine Thresholds ───────────────────────────────────────────────
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
FAILURE_RATE_THRESHOLD=30
WORKER_STALL_MINUTES=10

# ── Security & Authentication ────────────────────────────────────────────────
# In production, generate a cryptographically strong 32+ char key
MONITORING_API_KEY=dev-monitoring-key-change-me
JWT_SECRET=wf-engine-s3cr3t-jwt-k3y-change-in-production

# ── Real-Time WebSocket Transport ────────────────────────────────────────────
ALLOWED_WS_ORIGINS=*
WS_MAX_CLIENTS=100
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_SLOW_CLIENT_BYTES=262144
WS_POLL_INTERVAL_MS=5000

# ── Grafana Credentials & Config ────────────────────────────────────────────
# REQUIRED — no defaults; Docker Compose will refuse to start without these
GF_ADMIN_USER=<set-a-secure-username>
GF_ADMIN_PASSWORD=<set-a-secure-password>
GRAFANA_ADMIN_USER=<set-a-secure-username>
GRAFANA_ADMIN_PASSWORD=<set-a-secure-password>

# ── Alertmanager Routing & Webhook Notification Endpoints ────────────────────
SMTP_SMARTHOST=localhost:25
ALERT_EMAIL_FROM=alerts@workflow-engine.local
ALERT_WEBHOOK_URL=http://workflow-monitoring:4000/alerts/webhook
CRITICAL_WEBHOOK_URL=http://workflow-monitoring:4000/alerts/webhook
