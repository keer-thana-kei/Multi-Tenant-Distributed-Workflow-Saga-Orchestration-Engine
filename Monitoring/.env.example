# Monitoring Service Environment Configuration
# Copy this file to .env (do NOT commit .env with real credentials)

# ── Service Network & Ports ──────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://workflow-backend:5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# ── Telemetry & Health Checks ────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
DEPENDENCY_TIMEOUT_MS=4000

# ── Alerting Engine Thresholds ───────────────────────────────────────────────
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
FAILURE_RATE_THRESHOLD=30
WORKER_STALL_MINUTES=10

# ── Security & Authentication ────────────────────────────────────────────────
# In production, generate a cryptographically strong 32+ char key
MONITORING_API_KEY=dev-monitoring-key-change-me
JWT_SECRET=wf-engine-s3cr3t-jwt-k3y-change-in-production

# ── Real-Time WebSocket Transport ────────────────────────────────────────────
ALLOWED_WS_ORIGINS=*
WS_MAX_CLIENTS=100
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=10000
WS_SLOW_CLIENT_BYTES=262144
WS_POLL_INTERVAL_MS=5000

# ── Grafana Credentials & Config ────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Alertmanager Routing & Webhook Notification Endpoints ────────────────────
SMTP_SMARTHOST=localhost:25
ALERT_EMAIL_FROM=alerts@workflow-engine.local
ALERT_WEBHOOK_URL=http://workflow-monitoring:4000/alerts/webhook
CRITICAL_WEBHOOK_URL=http://workflow-monitoring:4000/alerts/webhook
